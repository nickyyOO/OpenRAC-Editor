#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")

import editor_theme_builders

# Fonts
# OpenRAC Editor: only the fonts the English editor uses.
flist = Glob("#thirdparty/fonts/Inter_*.woff2")
flist.extend(Glob("#thirdparty/fonts/JetBrainsMono_*.woff2"))
flist.sort()
env.CommandNoCache(
    "#editor/themes/builtin_fonts.gen.h",
    flist,
    env.Run(editor_theme_builders.make_fonts_header),
)

env.add_source_files(env.editor_sources, "*.cpp")
